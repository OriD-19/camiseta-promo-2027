# URL /exec de la aplicación web de Apps Script (docs/APPS_SCRIPT.md, paso 8).
# Si queda vacía, el sitio usa un backend simulado con datos de ejemplo.
VITE_APPS_SCRIPT_URL=

# Ruta base del sitio: "/" con dominio propio, "/<nombre-del-repo>/" en GitHub Pages sin dominio.
VITE_BASE=/

# Client ID de OAuth (tipo "Aplicación web") para el acceso de representantes al dashboard
# (docs/APPS_SCRIPT.md, paso 5). Debe ser el mismo que GOOGLE_CLIENT_ID en Apps Script.
# Con el mock (sin VITE_APPS_SCRIPT_URL) no hace falta.
VITE_GOOGLE_CLIENT_ID=
